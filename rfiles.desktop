[Desktop Entry]
Name=RFiles
Comment=Black, tabbed file explorer with live preview
Exec=rfiles %U
Icon=io.github.rfiles.Files
Terminal=false
Type=Application
Categories=System;Utility;FileManager;
MimeType=inode/directory;
Actions=new-window;
StartupWMClass=io.github.rfiles.Files

[Desktop Action new-window]
Name=New Window
Exec=rfiles
